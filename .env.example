# MongoDB
MONGODB_URI=mongodb://localhost:27017/regal-horeca

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Admin auth (JWT + httpOnly cookies)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# Optional legacy alias:
# JWT_SECRET=

# Seed first super_admin (run: npm run seed:super-admin)
SUPER_ADMIN_EMAIL=admin@regal-horeca.com
SUPER_ADMIN_PASSWORD=
# Optional alias used by seed script:
# ADMIN_PASSWORD=

# Local dev only — bypasses API auth (never set in production)
# SKIP_ADMIN_AUTH=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=

# On-demand cache revalidation
REVALIDATE_SECRET=
